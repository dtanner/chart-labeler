"""Runs chart-labeler from any directory.

Can be symlinked onto the PATH: the chart_labeler package is found next to
this file's real location, and PDF paths stay relative to the directory it is
called from.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from chart_labeler.cli import main  # noqa: E402

main()
